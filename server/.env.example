# Copy to .env and fill in. Everything here is optional except where noted.
PORT=8787

# Plaid keys from https://dashboard.plaid.com/developers/keys
# Leave blank to run without bank syncing.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox                 # sandbox or production
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# PLAID_REDIRECT_URI=https://your-domain.example.com/   # needed for OAuth banks (Chase, etc.)
# PLAID_WEBHOOK_URL=https://your-domain.example.com/api/plaid/webhook

# Required when Plaid keys are set. Encrypts bank access tokens at rest.
# Generate with: npm run keygen
ENCRYPTION_KEY=

# ── Owner & customers ──
# Accounts with these emails can open the owner dashboard at /owner (comma separated).
OWNER_EMAILS=you@example.com
# Free trial for new accounts, no card needed. 0 turns it off.
TRIAL_DAYS=14
# Shown on the sign-in and subscription screens.
SUPPORT_EMAIL=
# Optional: new customers must enter this code to sign up (useful for a private beta).
INVITE_CODE=

# ── Billing (Lemon Squeezy) ──
# Leave blank and everyone uses the app for free.
# Settings → Webhooks in Lemon Squeezy: URL https://your-domain/api/billing/webhook,
# send every subscription_* and order_* event, and paste the signing secret here.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Your plans. variantId is the numeric variant ID; checkoutUrl is the variant's "Share" link.
LEMONSQUEEZY_PLANS=[{"id":"monthly","name":"Monthly","price":9.99,"interval":"month","variantId":"","checkoutUrl":""},{"id":"yearly","name":"Yearly","price":79.99,"interval":"year","variantId":"","checkoutUrl":""}]
# Optional fallback for "Manage subscription" (normally each customer's own portal link is used).
LEMONSQUEEZY_MANAGE_URL=

# Optional: what one bank connection costs you per month at Plaid, for the owner dashboard.
PLAID_MONTHLY_COST_PER_ITEM=

# Optional: extra browser origins allowed to call the API (comma separated).
# The iOS and Android app origins are always allowed.
# ALLOWED_ORIGINS=https://your-domain.example.com

# DB_PATH=./data/safe-to-spend.db
